# Environment file for the SDD context module.
#
# Every value below is a placeholder or a local default. Copy this file, fill in
# the real MiniMax API key, and keep the copy out of version control.

# --- seekdb: stores the engineering material and the PowerContext state ---
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sdd_context

# --- PowerContext: stores the task progress ---
POWERCONTEXT_SERVER_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE_ID=

# --- MiniMax: produces the code change ---
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2

# --- module workspace ---
SDD_REPOSITORY_ROOT=.
SDD_WORKSPACE_DIR=minimax/workload
