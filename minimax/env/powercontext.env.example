# PowerContext Server environment file for the SDD context module.
#
# The Server keeps its own task state in a local SQLite database that lives under
# POWERCONTEXT_HOME. The engineering material lives in the separate seekdb
# instance that minimax/sddctx/material_store.py talks to.

POWERCONTEXT_SERVER_DATABASE_KIND=sqlite

POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000

POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_ACCESS_DEPLOYMENT_ID=powercontext

POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
POWERCONTEXT_SERVER_LOGGING_FORMAT=console
POWERCONTEXT_SERVER_METRICS_ENABLED=false
POWERCONTEXT_SERVER_TRACING_ENABLED=false

# The module drives the model itself through the MiniMax OpenAI-compatible API,
# so the Server needs no inference provider of its own. Background processing
# stays off because it would issue model calls.
POWERCONTEXT_SERVER_RUNTIME_DREAM_ENABLED=false
POWERCONTEXT_SERVER_RUNTIME_ARTIFACT_PROCESSING_ROLE=api
POWERCONTEXT_SERVER_HANDOFF_REPORT_ENABLED=false
